# Copie para .env e preencha. O .env tem a senha do banco: não vá para o git.
# Qual cenário escolher: docs/instalar/escolha.md.

# Qual arquivo o "docker compose" usa nesta pasta (assim nenhum comando
# precisa de -f, nem o backup.sh e o restaurar.sh):
#   compose.yml        rede local, sem domínio (porta 8443, CA da instalação)
#   compose.proxy.yml  atrás de um proxy que já existe (Nginx, Traefik…)
#   compose.caddy.yml  VPS do zero, com Caddy e Let's Encrypt
COMPOSE_FILE=compose.yml

# Senha do PostgreSQL. Só letras e números (ela entra numa URL):
#   openssl rand -hex 24
INVENIRE_PG_PASSWORD=

# Opcional: código da primeira configuração (/setup). Sem ele, o servidor
# gera um e o mostra no log.
#INVENIRE_SETUP_CODE=

# --- compose.yml (rede local) ------------------------------------------------

# Nomes e IPs pelos quais as máquinas (e o navegador) chamam o servidor,
# separados por vírgula. O endereço usado no cadastro precisa estar aqui.
INVENIRE_HOSTS=localhost,invenire.local,192.168.0.10

# Porta publicada na máquina do servidor.
#INVENIRE_PORT=8443

# --- compose.proxy.yml (proxy que já existe) ---------------------------------

# IPs ou faixas (CIDR) de onde o proxy conecta, separados por vírgula. O
# padrão serve ao proxy nesta mesma máquina (veja compose.proxy.yml).
#INVENIRE_TRUSTED_PROXIES=172.31.250.0/24

# Onde a porta HTTP do servidor é publicada: 127.0.0.1 com o proxy nesta
# máquina; o IP da rede local com o proxy em outra.
#INVENIRE_BIND=127.0.0.1
#INVENIRE_HTTP_PORT=8080

# --- compose.caddy.yml (VPS) -------------------------------------------------

# Domínio que aponta (registro A/AAAA) para esta máquina.
#INVENIRE_DOMAIN=invenire.exemplo.org

# --- imagem ------------------------------------------------------------------

# Imagem do servidor, publicada a cada versão (amd64 e arm64).
#INVENIRE_IMAGE=ghcr.io/invenire-hq/invenire-server
# Versão da imagem. Fixar uma versão (ex.: 0.1.0) evita que um "docker compose
# pull" troque de versão sem você decidir; atualizar é mudar aqui. Com
# "docker compose up --build", é também a versão gravada no binário montado
# a partir do repositório.
#INVENIRE_VERSION=latest
