# Copie para .env e preencha. O .env tem a senha do banco: não vá para o git.

# Senha do PostgreSQL. Só letras e números (ela entra numa URL):
#   openssl rand -hex 24
INVENIRE_PG_PASSWORD=

# Nomes e IPs pelos quais as máquinas chamam o servidor, separados por
# vírgula. O endereço usado no cadastro do agente precisa estar aqui.
INVENIRE_HOSTS=localhost,invenire.prefeitura.local,10.0.0.5

# Porta publicada na máquina do servidor.
INVENIRE_PORT=8443

# Versão gravada no binário e na imagem.
INVENIRE_VERSION=piloto
